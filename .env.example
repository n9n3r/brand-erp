# MyBrand — environment variables
# Copy to .env and fill in. `npm run gen:secret` prints a safe JWT secret.

# PostgreSQL connection (pooled). Local default; use your Neon pooled URL in production.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/brandos?schema=public&connection_limit=10&pool_timeout=30&connect_timeout=10"

# HS256 secret for session JWTs — REQUIRED, use a long random string.
JWT_SECRET="replace-with-output-of-npm-run-gen-secret"

# Public origin of the app (used in password-reset / verification links).
APP_URL="http://localhost:3000"

# Optional — enable real reset/verification emails via Resend.
# Without it, links are logged to the server console (and returned in API
# responses while NODE_ENV=development).
RESEND_API_KEY=""
MAIL_FROM="MyBrand <noreply@yourdomain>"

# Only used by `npm run db:seed` — change it before seeding anywhere shared.
SEED_SUPER_ADMIN_PASSWORD="Admin123!"
